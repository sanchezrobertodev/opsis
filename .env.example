# Copy to .env and adjust. Never commit .env. Restart `pnpm dev` (API and worker) after changing it.

# Postgres (docker compose maps 5433 -> 5432 to avoid clashing with a local install)
DATABASE_URL=postgresql+asyncpg://studio:studio@127.0.0.1:5433/studio
QUEUE_DATABASE_URL=postgresql://studio:studio@127.0.0.1:5433/studio

# mock | mixed | live. mock is the default; paid routes are never called in mock mode.
# This is the ceiling: Settings > Providers can switch to this mode or a safer one, with no restart.
PROVIDER_MODE=mock
# Comma-separated route ids allowed to run live when PROVIDER_MODE=mixed, e.g. kling-3.0@fal
LIVE_ROUTE_ALLOWLIST=

MEDIA_ROOT=./data/media
REGISTRY_DIR=./registry
WEB_ORIGIN=http://localhost:3000

# Provider keys: add the ones you have. Without a key, that provider's routes are unavailable.
# fal.ai, most hosted models; also hosts files for RunPod: https://fal.ai/dashboard/keys
FAL_KEY=
# Google (Gemini, Veo, Nano Banana): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Runway: https://dev.runwayml.com/
RUNWAY_API_KEY=
# Replicate: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Claude: mock returns canned scripts and prompt help; live calls the API (billed, counted in your budget).
# Key: https://platform.claude.com/settings/keys
LLM_MODE=mock
ANTHROPIC_API_KEY=
# RunPod public endpoints and your own open-model endpoint; inputs are hosted via FAL_KEY.
# Key: https://console.runpod.io/user/settings
RUNPOD_API_KEY=
# Your own wan-core endpoint id (infra/runpod/wan-core); empty turns its routes off
RUNPOD_WAN_CORE_ENDPOINT=
# Narration, sound effects, music, voice cloning and dubbing: https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=
# Optional FastH3-Omni streaming sessions (docs/reactor.md): install with uv sync --extra reactor.
# Billed by GPU session time, including idle time. No API balance reader yet. Key: https://reactor.inc/dashboard
REACTOR_API_KEY=
# Optional Seedance 2.5 route (docs/pika.md). Pika API Club membership plus usage charges: https://dev.pika.art/
PIKA_API_KEY=
# Marble explorable worlds. Usage past your prepaid credits is billed to your card at month end.
# Key: https://platform.worldlabs.ai/
WORLDLABS_API_KEY=

# The API's port (8000 is often taken by other local containers). If you change it, also set
# NEXT_PUBLIC_API_URL=http://127.0.0.1:<port> in apps/web/.env.local so the web app finds it.
# The web app is on 3000 and Postgres on 5433 (OPSIS_DB_PORT moves it; then fix both URLs above).
API_PORT=8400

# Local ComfyUI (see README: Open models on your GPU). Leave empty to turn the local route off.
COMFYUI_URL=http://127.0.0.1:8188
# Optional local model-folder settings. See docs/local-model-storage.md for launcher setup.
# COMFYUI_MODEL_PATHS_CONFIG=
# GPT Image through the Codex CLI signed in with ChatGPT (the plan's allowance, slow; fal takes what it can't draw).
# Empty turns it off. A standalone install on Linux: /home/<you>/.codex/packages/standalone/current/bin/codex
CODEX_BIN=
