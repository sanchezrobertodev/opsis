# Copy to .env and adjust. Never commit .env.

# Postgres (docker compose maps 5433 -> 5432 to avoid clashing with a local install)
DATABASE_URL=postgresql+asyncpg://studio:studio@127.0.0.1:5433/studio
QUEUE_DATABASE_URL=postgresql://studio:studio@127.0.0.1:5433/studio

# mock | mixed | live. mock is the default; paid routes are never called in mock mode.
PROVIDER_MODE=mock
# Comma-separated route ids allowed to run live when PROVIDER_MODE=mixed
LIVE_ROUTE_ALLOWLIST=

MEDIA_ROOT=./data/media
REGISTRY_DIR=./registry
WEB_ORIGIN=http://localhost:3000

# Provider keys (needed from P1 on)
FAL_KEY=
GEMINI_API_KEY=
RUNWAY_API_KEY=
REPLICATE_API_TOKEN=
# Claude: mock returns canned prompt enhancements; live calls the API (billed, counted in your budget)
LLM_MODE=mock
ANTHROPIC_API_KEY=
# RunPod public endpoints and (later) our own open-model endpoints; inputs are hosted via FAL_KEY
RUNPOD_API_KEY=
# Your own wan-core endpoint id (infra/runpod/wan-core); empty turns its routes off
RUNPOD_WAN_CORE_ENDPOINT=
# Narration, sound effects and music
ELEVENLABS_API_KEY=
# Optional FastH3-Omni streaming sessions: install with uv sync --extra reactor.
# Billed by GPU session time, including idle time. No API balance reader yet.
REACTOR_API_KEY=
# Optional Seedance 2.5 route. Pika API Club membership plus usage charges.
PIKA_API_KEY=
# Marble explorable worlds. Usage past your prepaid credits is billed to your card at month end.
WORLDLABS_API_KEY=

# Ports (8000 is often taken by other local containers)
API_PORT=8400

# Local ComfyUI (see README: Run a real video on your GPU). Leave empty to turn the local route off.
COMFYUI_URL=http://127.0.0.1:8188
# Optional local model-folder settings. See docs/local-model-storage.md for launcher setup.
# COMFYUI_MODEL_PATHS_CONFIG=
# GPT Image through the Codex CLI signed in with ChatGPT (the plan's allowance, slow; fal takes what it can't draw).
# Empty turns it off. On the home server: /home/<you>/.codex/packages/standalone/current/bin/codex
CODEX_BIN=
