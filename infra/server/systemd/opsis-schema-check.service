[Unit]
Description=Opsis provider schema check (report in data/reports/)
Requires=opsis-worker.service
After=opsis-worker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec opsis-worker python scripts/fetch_provider_schemas.py
StandardOutput=append:@APP_DIR@/data/logs/schema-drift.log
StandardError=append:@APP_DIR@/data/logs/schema-drift.log
