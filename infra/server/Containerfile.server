# The studio's API and worker for a Linux server (one image, two containers; see infra/server/README.md).
# Build from the repo root: podman build -f infra/server/Containerfile.server --ignorefile .dockerignore .
FROM docker.io/library/python:3.12-slim-trixie

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH=/app/.venv/bin:$PATH

# ffmpeg with x264 and libass (assembly, captions), the system file-type table (uploads guess types from names), the
# Postgres 18 client tools for backups (PGDG), and open fonts standing in for the caption looks' Windows fonts
# (fonts.conf maps the names).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg ffmpeg fontconfig media-types \
      fonts-liberation2 fonts-dejavu-core fonts-comic-neue \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-18 \
 && rm -rf /var/lib/apt/lists/*
COPY infra/server/fonts.conf /etc/fonts/local.conf
RUN fc-cache -f

COPY --from=ghcr.io/astral-sh/uv:0.7.3 /uv /usr/local/bin/uv

WORKDIR /app
# Dependencies first, so a code change doesn't reinstall them
COPY pyproject.toml uv.lock ./
COPY apps/server/pyproject.toml apps/server/pyproject.toml
RUN uv sync --frozen --no-dev --no-install-workspace

COPY apps/server apps/server
COPY registry registry
COPY workflows workflows
COPY scripts scripts
RUN uv sync --frozen --no-dev

# data/ (media, backups, logs, reports) is a bind mount; settings come from the environment, not a .env in the image
VOLUME /app/data
EXPOSE 8400
CMD ["python", "-m", "studio.api", "--host", "0.0.0.0", "--port", "8400"]
