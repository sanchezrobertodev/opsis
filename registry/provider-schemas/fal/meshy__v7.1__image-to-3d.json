{
 "endpoint": "meshy/v7.1/image-to-3d",
 "variant": null,
 "input": {
  "animation_action_id": {
   "type": "integer",
   "default": 92
  },
  "enable_animation": {
   "type": "boolean"
  },
  "enable_pbr": {
   "type": "boolean"
  },
  "enable_rigging": {
   "type": "boolean"
  },
  "enable_safety_checker": {
   "type": "boolean",
   "default": true
  },
  "geometry_resolution": {
   "type": "null|string",
   "enum": [
    "standard",
    "2k",
    "4k"
   ]
  },
  "image_url": {
   "type": "string"
  },
  "is_a_t_pose": {
   "type": "boolean",
   "deprecated": true
  },
  "model_type": {
   "type": "string",
   "enum": [
    "standard",
    "lowpoly",
    "smart-topology"
   ],
   "default": "standard"
  },
  "pose_mode": {
   "type": "string",
   "enum": [
    "a-pose",
    "t-pose",
    ""
   ],
   "default": ""
  },
  "rigging_height_meters": {
   "type": "number",
   "default": 1.7
  },
  "should_remesh": {
   "type": "boolean",
   "default": true
  },
  "should_texture": {
   "type": "boolean",
   "default": true
  },
  "symmetry_mode": {
   "type": "string",
   "enum": [
    "off",
    "auto",
    "on"
   ],
   "default": "auto"
  },
  "target_polycount": {
   "type": "integer",
   "default": 30000,
   "minimum": 100,
   "maximum": 300000
  },
  "texture_image_url": {
   "type": "null|string"
  },
  "texture_prompt": {
   "type": "null|string"
  },
  "topology": {
   "type": "string",
   "enum": [
    "quad",
    "triangle"
   ],
   "default": "triangle"
  },
  "ultra_mode": {
   "type": "boolean",
   "deprecated": true
  }
 },
 "required": [
  "image_url"
 ],
 "output": [
  "animation_fbx",
  "animation_glb",
  "basic_animations",
  "model_glb",
  "model_urls",
  "rig_task_id",
  "rigged_character_fbx",
  "rigged_character_glb",
  "seed",
  "texture_urls",
  "thumbnail"
 ],
 "deprecated": false
}
