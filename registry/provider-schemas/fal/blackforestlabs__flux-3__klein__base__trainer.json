{
 "endpoint": "blackforestlabs/flux-3/klein/base/trainer",
 "variant": null,
 "input": {
  "enable_safety_checker": {
   "type": "boolean",
   "default": true
  },
  "images_data_url": {
   "type": "string"
  },
  "learning_rate": {
   "type": "number",
   "default": 0.0001,
   "minimum": 1e-06,
   "maximum": 0.01
  },
  "resolution": {
   "type": "integer",
   "enum": [
    512,
    768,
    1024
   ],
   "default": 1024
  },
  "steps": {
   "type": "integer",
   "default": 1000,
   "minimum": 100,
   "maximum": 10000
  },
  "trigger_phrase": {
   "type": "string",
   "default": ""
  }
 },
 "required": [
  "images_data_url"
 ],
 "output": [
  "config_file",
  "lora_file"
 ],
 "deprecated": false
}
