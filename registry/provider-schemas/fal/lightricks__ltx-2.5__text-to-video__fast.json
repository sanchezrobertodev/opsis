    "16:9",
    "9:16"
   ],
   "default": "16:9"
  },
  "camera_motion": {
   "type": "null|string",
   "enum": [
    "dolly_in",
    "dolly_out",
    "dolly_left",
    "dolly_right",
    "jib_up",
    "jib_down",
    "static",
    "focus_shift"
   ]
  },
  "duration": {
   "type": "any",
   "enum": [
    6,
    8,
    10,
    12,
    14,
    16,
    18,
    20,
    "auto"
   ],
   "default": "auto"
  },
  "fps": {
   "type": "integer",
   "enum": [
    24,
    25,
    48,
    50
   ],
   "default": 25
