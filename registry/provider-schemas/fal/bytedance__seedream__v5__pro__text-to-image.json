{
 "endpoint": "bytedance/seedream/v5/pro/text-to-image",
 "variant": null,
 "input": {
  "enable_safety_checker": {
   "type": "boolean",
   "default": true
  },
  "enhance_prompt_mode": {
   "type": "string",
   "enum": [
    "standard",
    "fast"
   ],
   "default": "standard"
  },
  "image_size": {
   "type": "object<ImageSize>|string",
   "enum": [
    "square_hd",
    "square",
    "portrait_4_3",
    "portrait_16_9",
    "landscape_4_3",
    "landscape_16_9",
    "auto_1K",
    "auto_2K"
   ],
   "default": "auto_2K"
  },
  "num_images": {
   "type": "integer",
   "default": 1,
   "minimum": 1,
   "maximum": 6
  },
  "output_format": {
   "type": "string",
   "enum": [
    "jpeg",
    "png"
   ],
   "default": "jpeg"
  },
  "prompt": {
   "type": "string"
  },
  "sync_mode": {
   "type": "boolean"
  }
 },
 "required": [
  "prompt"
 ],
 "output": [
  "images"
 ],
 "deprecated": false
}
