{
 "endpoint": "minimax/h3-max/reference-to-video",
 "variant": null,
 "input": {
  "aspect_ratio": {
   "type": "string",
   "enum": [
    "adaptive",
    "21:9",
    "16:9",
    "4:3",
    "1:1",
    "3:4",
    "9:16"
   ],
   "default": "adaptive"
  },
  "duration": {
   "type": "number",
   "default": 5,
   "minimum": 0.92,
   "maximum": 15
  },
  "enable_safety_checker": {
   "type": "boolean",
   "default": true
  },
  "end_image_url": {
   "type": "null|string"
  },
  "image_url": {
   "type": "null|string"
  },
  "middle_frame_time": {
   "type": "null|number"
  },
  "middle_image_url": {
   "type": "null|string"
  },
  "prompt": {
   "type": "string"
  },
  "prompt_expansion_mode": {
   "type": "string",
   "default": "balanced"
  },
  "reference_audio_urls": {
   "type": "array<string>",
   "maxItems": 3
  },
  "reference_conditions": {
   "type": "array<object<ReferenceCondition>>",
   "maxItems": 12
  },
  "reference_image_urls": {
   "type": "array<string>",
   "maxItems": 9
  },
  "reference_video_urls": {
   "type": "array<string>",
   "maxItems": 3
  },
  "resolution": {
   "type": "string",
   "enum": [
    "480P",
    "768P",
    "1080P"
   ],
   "default": "768P"
  },
  "seed": {
   "type": "integer|null"
  },
  "sync_mode": {
   "type": "boolean"
  }
 },
 "required": [
  "prompt",
  "prompt_expansion_mode"
 ],
 "output": [
  "expanded_prompt",
  "seed",
  "timings",
  "video"
 ],
 "deprecated": false
}
