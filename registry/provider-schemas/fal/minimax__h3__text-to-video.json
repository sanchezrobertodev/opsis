{
 "endpoint": "minimax/h3/text-to-video",
 "variant": null,
 "input": {
  "aspect_ratio": {
   "type": "string",
   "enum": [
    "21:9",
    "16:9",
    "4:3",
    "1:1",
    "3:4",
    "9:16"
   ],
   "default": "16:9"
  },
  "duration": {
   "type": "integer",
   "default": 5,
   "minimum": 5,
   "maximum": 15
  },
  "enable_safety_checker": {
   "type": "boolean",
   "default": true
  },
  "prompt": {
   "type": "string"
  },
  "prompt_expansion_mode": {
   "type": "null|string",
   "default": "balanced"
  },
  "resolution": {
   "type": "string",
   "enum": [
    "480P",
    "768P",
    "2K",
    "4K"
   ],
   "default": "2K"
  },
  "seed": {
   "type": "integer|null"
  },
  "sync_mode": {
   "type": "boolean"
  },
  "target_audio_url": {
   "type": "null|string"
  }
 },
 "required": [
  "prompt"
 ],
 "output": [
  "expanded_prompt",
  "video"
 ],
 "deprecated": false
}
