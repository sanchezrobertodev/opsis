{
 "endpoint": "openai/gpt-image-2.5/sunburst/edit",
 "variant": null,
 "input": {
  "background": {
   "type": "string",
   "enum": [
    "auto",
    "transparent",
    "opaque"
   ],
   "default": "auto"
  },
  "enable_safety_checker": {
   "type": "boolean",
   "default": true
  },
  "image_size": {
   "type": "object<ImageSize>|string",
   "enum": [
    "square_hd",
    "square",
    "portrait_4_3",
    "portrait_16_9",
    "landscape_4_3",
    "landscape_16_9",
    "auto"
   ],
   "default": "auto"
  },
  "image_urls": {
   "type": "array<string>",
   "maxItems": 16
  },
  "mask_url": {
   "type": "null|string"
  },
  "num_images": {
   "type": "integer",
   "default": 1,
   "minimum": 1,
   "maximum": 10
  },
  "output_compression": {
   "type": "integer|null",
   "minimum": 0,
   "maximum": 100
  },
  "output_format": {
   "type": "string",
   "enum": [
    "jpeg",
    "png",
    "webp"
   ],
   "default": "png"
  },
  "prompt": {
   "type": "string"
  },
  "quality": {
   "type": "string",
   "enum": [
    "auto",
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
   ],
   "default": "high"
  },
  "sync_mode": {
   "type": "boolean"
  }
 },
 "required": [
  "image_urls",
  "prompt"
 ],
 "output": [
  "images"
 ],
 "deprecated": false
}
