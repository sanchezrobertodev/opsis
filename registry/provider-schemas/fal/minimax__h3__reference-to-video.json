{
 "endpoint": "minimax/h3/reference-to-video",
 "variant": null,
 "input": {
  "aspect_ratio": {
   "type": "string",
   "enum": [
    "adaptive",
    "21:9",
    "16:9",
    "4:3",
    "1:1",
    "3:4",
    "9:16"
   ],
   "default": "adaptive"
  },
  "duration": {
   "type": "integer",
   "default": 5,
   "minimum": 5,
   "maximum": 15
  },
  "enable_safety_checker": {
   "type": "boolean",
   "default": true
  },
  "prompt": {
   "type": "string"
  },
  "prompt_expansion_mode": {
   "type": "null|string",
   "default": "balanced"
  },
  "reference_audio_urls": {
   "type": "array<string>",
   "maxItems": 3
  },
  "reference_image_urls": {
   "type": "array<string>",
   "maxItems": 9
  },
  "reference_video_urls": {
   "type": "array<string>",
   "maxItems": 3
  },
  "resolution": {
   "type": "string",
   "enum": [
    "480P",
    "768P",
    "2K",
    "4K"
   ],
   "default": "2K"
  },
  "seed": {
   "type": "integer|null"
  },
  "sync_mode": {
   "type": "boolean"
  }
 },
 "required": [
  "prompt"
 ],
 "output": [
  "expanded_prompt",
  "video"
 ],
 "deprecated": false
}
