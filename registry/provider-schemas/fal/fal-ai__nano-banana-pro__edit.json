{
 "endpoint": "fal-ai/nano-banana-pro/edit",
 "variant": null,
 "input": {
  "aspect_ratio": {
   "type": "null|string",
   "enum": [
    "auto",
    "21:9",
    "16:9",
    "3:2",
    "4:3",
    "5:4",
    "1:1",
    "4:5",
    "3:4",
    "2:3",
    "9:16",
    "4:1",
    "1:4",
    "8:1",
    "1:8"
   ],
   "default": "auto"
  },
  "context": {
   "type": "array<object<GeminiDocumentPart>|object<GeminiImagePart>|object<GeminiSignaturePart>|object<GeminiTextPart>>"
  },
  "enable_web_search": {
   "type": "boolean"
  },
  "history": {
   "type": "array<object<GeminiMessage>>"
  },
  "image_urls": {
   "type": "array<string>"
  },
  "include_thoughts": {
   "type": "boolean|null"
  },
  "limit_generations": {
   "type": "boolean",
   "default": true
  },
  "max_output_tokens": {
   "type": "integer|null",
   "minimum": 1,
   "maximum": 32768
  },
  "num_images": {
   "type": "integer",
   "default": 1,
   "minimum": 1,
   "maximum": 4
  },
  "output_format": {
   "type": "string",
   "enum": [
    "jpeg",
    "png",
    "webp"
   ],
   "default": "png"
  },
  "prompt": {
   "type": "string"
  },
  "resolution": {
   "type": "string",
   "enum": [
    "1K",
    "2K",
    "4K"
   ],
   "default": "1K"
  },
  "return_history": {
   "type": "boolean"
  },
  "safety_tolerance": {
   "type": "string",
   "enum": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "6"
   ],
   "default": "4"
  },
  "seed": {
   "type": "integer|null"
  },
  "sync_mode": {
   "type": "boolean"
  },
  "system_prompt": {
   "type": "string",
   "default": ""
  },
  "temperature": {
   "type": "null|number",
   "minimum": 0,
   "maximum": 2
  },
  "thinking_level": {
   "type": "null|str",
   "enum": [
    "high"
   ]
  },
  "top_p": {
   "type": "null|number",
   "minimum": 0,
   "maximum": 1
  }
 },
 "required": [
  "prompt"
 ],
 "output": [
  "conversations",
  "description",
  "grounding_metadata",
  "images"
 ],
 "deprecated": false
}
