{
 "endpoint": "bytedance/seedream/v5/lite/edit",
 "variant": null,
 "input": {
  "enable_safety_checker": {
   "type": "boolean",
   "default": true
  },
  "image_size": {
   "type": "object<ImageSize>|string",
   "enum": [
    "square_hd",
    "square",
    "portrait_4_3",
    "portrait_16_9",
    "landscape_4_3",
    "landscape_16_9",
    "auto_2K",
    "auto_3K",
    "auto_4K"
   ],
   "default": "auto_2K"
  },
  "image_urls": {
   "type": "array<string>"
  },
  "max_images": {
   "type": "integer",
   "default": 1,
   "minimum": 1,
   "maximum": 6
  },
  "num_images": {
   "type": "integer",
   "default": 1,
   "minimum": 1,
   "maximum": 6
  },
  "prompt": {
   "type": "string"
  },
  "sync_mode": {
   "type": "boolean"
  }
 },
 "required": [
  "image_urls",
  "prompt"
 ],
 "output": [
  "images",
  "seed"
 ],
 "deprecated": false
}
