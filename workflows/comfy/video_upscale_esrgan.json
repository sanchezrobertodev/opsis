{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "input.mp4"
    },
    "_meta": {
      "title": "Clip to upscale"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Frames, sound and rate"
    }
  },
  "3": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "4x_NMKD-Siax_200k.pth"
    },
    "_meta": {
      "title": "Upscale model"
    }
  },
  "4": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "3",
        0
      ],
      "image": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Upscale every frame"
    }
  },
  "5": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "4",
        0
      ],
      "upscale_method": "area",
      "width": 2560,
      "height": 1440,
      "crop": "disabled"
    },
    "_meta": {
      "title": "Down to the size asked"
    }
  },
  "6": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "fps": [
        "2",
        2
      ],
      "audio": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "CreateVideo"
    }
  },
  "7": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "6",
        0
      ],
      "filename_prefix": "opsis/upscale",
      "format": "mp4",
      "codec": "h264"
    },
    "_meta": {
      "title": "Your video"
    }
  }
}
